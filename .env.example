# ============================================================
#  FutbolApp — variables de entorno
#  Copia este archivo a .env y rellena los valores.
#  En producción se cargan desde el panel de Dokploy, NO desde un archivo.
# ============================================================

# --- Base de datos (Supabase) ---
# Settings → API → Project URL y clave service_role
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=

# --- Sesiones ---
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Cobro con tarjeta (PayPal) ---
# live | sandbox
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- Asistente de IA (nivel gratuito de Gemini) ---
# Sin esta clave la IA sigue respondiendo, pero con analisis calculado en vez de generado.
GEMINI_API_KEY=

# --- Correo para recuperar contrasena ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# --- Codigos de alta de ENTRENADOR (separados por coma) ---
# Quien tenga uno de estos puede crear una cuenta de entrenador.
CODIGOS_ENTRENADOR=CAMBIAME

# --- Administradores (correos separados por coma) ---
ADMIN_EMAILS=

# --- Entorno ---
ENTORNO=produccion
FORZAR_HTTPS=1
TIMEZONE=America/Guayaquil
LOG_LEVEL=info
